        "%%sql\n",
        "\n",
        "SELECT *,\n",
        "  s.orderdate,\n",
        "  s.quantity * s.netprice * s.exchangerate AS net_revenue,\n",
        "  c.givenname,\n",
        "  c.surname,\n",
        "  c.countryfull,\n",
        "  c.continent,\n",
        "  p.productkey,\n",
        "  p.productname,\n",
        "  p.categoryname,\n",
        "  p.subcategoryname\n",
        "FROM\n",
        "  sales s\n",
        "LEFT JOIN customer c\n",
        "  ON s.customerkey = c.customerkey\n",
        "LEFT JOIN product p\n",
        "  ON s.productkey = p.productkey\n",
        "Where\n",
        "  s.orderdate::DATE >= '01-01-2020'\n",
