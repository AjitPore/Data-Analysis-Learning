        "%%sql\n",
        "\n",
        "SELECT *,\n",
        "  s.orderdate,\n",
        "  s.quantity * s.netprice * s.exchangerate AS net_revenue,\n",
        "  c.givenname,\n",
        "  c.surname,\n",
        "  c.countryfull,\n",
        "  c.continent\n",
        "FROM\n",
        "  sales s\n",
        "LEFT JOIN customer c\n",
        "  ON s.customerkey = c.customerkey\n",
        "Where\n",
        "  s.orderdate::DATE >= '01-01-2020'\n",
        "LIMIT 10;"
